{
  "name": "handwritten-font-studio",
  "version": "0.2.54",
  "private": true,
  "scripts": {
    "test:regions-projects": "node scripts/regions-projects-check.mjs",
    "test:journey": "node scripts/journey-check.mjs",
    "test:flow": "node scripts/flow-check.mjs",
    "test:layout": "node scripts/font-layout-check.mjs",
    "test:latin": "node scripts/latin-check.mjs",
    "test:workspace": "node scripts/workspace-check.mjs",
    "test:usability": "node scripts/usability-check.mjs",
    "predev": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "test:export": "node scripts/font-browser-check.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/offline.mjs",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/browser-check.mjs",
    "test:font": "node scripts/font-check.mjs",
    "format": "prettier --write app components lib data config scripts *.json *.ts *.mjs *.md",
    "deploy": "node scripts/deploy-pages.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "idb": "^8.0.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.5",
    "opentype.js": "^1.3.4",
    "perfect-freehand": "^1.2.2",
    "polygon-clipping": "0.15.7",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "woff2-encoder": "^2.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
